{
    "model_name": "FieldMind Leaf Verification",
    "version": "1.0.0",
    "framework": "ONNX",
    "input": {
        "width": 224,
        "height": 224,
        "channels": 3
    },
    "preprocessing": {
        "color": "RGB",
        "resize": "224x224",
        "normalize": {
            "mean": [
                0.485,
                0.456,
                0.406
            ],
            "std": [
                0.229,
                0.224,
                0.225
            ]
        }
    },
    "classes": {
        "0": "non_leaf",
        "1": "leaf"
    },
    "confidence_threshold": 0.85,
    "output": "softmax"
}