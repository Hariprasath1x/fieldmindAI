# FieldMind — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Environment ──────────────────────────────────────────────────────────────
FIELDMIND_ENV=development          # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8002
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to the downloaded service-account JSON from Firebase Console.
FIREBASE_CREDENTIALS_PATH=backend/firebase_service_account.json
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS to the same path.

# ── Firebase (client-side, used by the React frontend) ───────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Backend URL (read by the React frontend via Vite) ────────────────────────
VITE_API_URL=http://localhost:8002

# ── ML model paths (relative to project root unless absolute) ─────────────────
MODELS_DIR=models

# ── Confidence thresholds ────────────────────────────────────────────────────
LEAF_VERIFICATION_THRESHOLD=0.85
DISEASE_HIGH_CONFIDENCE_THRESHOLD=0.75
DISEASE_MEDIUM_CONFIDENCE_THRESHOLD=0.45
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45

# ── Image quality gates ───────────────────────────────────────────────────────
IMAGE_BLUR_THRESHOLD=100.0         # Laplacian variance — lower = blurrier
MAX_IMAGE_SIZE_MB=10.0
MIN_IMAGE_DIMENSION_PX=64
RECOMMENDED_MIN_IMAGE_DIMENSION_PX=224

# ── Async inference ───────────────────────────────────────────────────────────
ASYNC_INFERENCE_ENABLED=false      # Set to true when Redis is running
REDIS_URL=redis://localhost:6379/0
JOB_TIMEOUT_SECONDS=120

# ── Evaluation pipeline ───────────────────────────────────────────────────────
EVALUATION_RESULTS_DIR=evaluation/results
